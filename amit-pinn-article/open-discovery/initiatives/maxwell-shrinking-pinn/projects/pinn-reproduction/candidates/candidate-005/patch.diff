> def theta_jet(net_f, net_t, eta, k=2):
>     L = getattr(net_f, "L", L_MAP)
>     xi = _xi_jet(eta, L, k)
>     M = list(_mlp_jet(net_t, torch.stack([2 * xi[0] - 1] + [2 * x for x in xi[1:]])))
>     P = _mul(xi, xi)
>     Q = [xi[j] - P[j] for j in range(k + 1)]
>     QM = _mul(Q, M)
>     return [1 - xi[0] + QM[0]] + [-xi[j] + QM[j] for j in range(1, k + 1)]
> 
