> # ---------------------------------------------------------------- candidate-001: Taylor-mode jets
> # Instead of building f', f'', f''' with three nested create_graph autograd passes, propagate
> # the value and its first k eta-derivatives ("jet") forward through the tanh MLP in closed form
> # (Faa di Bruno for tanh, Leibniz for products).  Same mathematics, one small graph.
> def _mlp_jet(mlp, zj):
>     """zj: tensor (k+1, n, 1) = input value and eta-derivatives. Returns (k+1, n, n_out)."""
>     k = zj.shape[0] - 1
>     mask = torch.zeros(k + 1, 1, 1, device=zj.device, dtype=zj.dtype)
>     mask[0] = 1.0
>     h = zj
>     for m in mlp.net:
>         if isinstance(m, nn.Linear):
>             h = h @ m.weight.T + mask * m.bias
>         else:  # Tanh
>             y = torch.tanh(h[0]); s = 1 - y * y
>             out = [y]
>             if k >= 1:
>                 out.append(s * h[1])
>             if k >= 2:
>                 t2 = -2 * y * s
>                 out.append(t2 * h[1] ** 2 + s * h[2])
>             if k >= 3:
>                 t3 = s * (4 * y * y - 2 * s)
>                 out.append(t3 * h[1] ** 3 + 3 * t2 * h[1] * h[2] + s * h[3])
>             h = torch.stack(out)
>     return h
> 
> 
> def _xi_jet(eta, L, k):
>     e = torch.exp(-eta / L)
>     xs = [1 - e]
>     for j in range(1, k + 1):
>         xs.append(((-1) ** (j + 1)) * e / L**j)
>     return xs
> 
> 
> def _mul(a, b):
>     """Leibniz product of two jets (lists) up to the shorter order."""
>     k = min(len(a), len(b)) - 1
>     C = [[1], [1, 1], [1, 2, 1], [1, 3, 3, 1]]
>     return [sum(C[n][i] * a[i] * b[n - i] for i in range(n + 1)) for n in range(k + 1)]
> 
> 
> def f_jet(net_f, eta, S, k=3):
>     L = getattr(net_f, "L", L_MAP)
>     xi = _xi_jet(eta, L, k)
>     N = list(_mlp_jet(net_f, torch.stack([2 * xi[0] - 1] + [2 * x for x in xi[1:]])))
>     P = _mul(xi, xi)
>     PN = _mul(P, N)
>     return [S - L * xi[0] + PN[0]] + [-L * xi[j] + PN[j] for j in range(1, k + 1)]
> 
